# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=c1d88233fe67c50565490a754596e11fd6b5196b8185e6cdebee9a573b90d881
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=nfledge
POSTGRES_PASSWORD=password
POSTGRES_DB=nfledge
DATABASE_URL=postgresql://nfledge:password@db:5432/nfledge
ASYNC_DATABASE_URL=postgresql+asyncpg://nfledge:password@db:5432/nfledge

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── ESPN (no API key required) ────────────────────────────────────────────────
# DraftKings lines are fetched via ESPN's undocumented public scoreboard API.
# Provider 1002 = DraftKings, 1004 = ESPN BET (fallback if DK missing).
# No key, no signup — just keep these at their defaults.
ESPN_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard
ESPN_CORE_URL=https://sports.core.api.espn.com/v2/sports/football/leagues/nfl

# ── Action Network (no API key required) ──────────────────────────────────────
# Free public-money consensus data: bet %, money %, bet counts.
# No key, no signup — just keep these at their defaults.
AN_SCOREBOARD_URL=https://api.actionnetwork.com/web/v1/scoreboard/nfl
AN_BOOK_ID=15

# ── Open-Meteo weather (no API key required) ──────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Public money scraper fallback (optional — your own scraper) ───────────────
# Only used if Action Network is unavailable. Set SCRAPER_SOURCE to skip.
SCRAPER_SOURCE=file                          # "file" | "endpoint" | "disabled"
SCRAPER_FILE_PATH=/data/public_money.json    # path inside the Docker volume
SCRAPER_ENDPOINT_URL=                        # e.g. http://scraper:8001/games
SCRAPER_API_KEY=                             # optional bearer token for endpoint

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440             # 24 hours
MAX_USERS=20

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","https://nfl-edge.vercel.app"]

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
